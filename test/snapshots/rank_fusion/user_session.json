[
  {
    "$rankFusion": {
      "combination": {
        "weights": {
          "lexical": 0.4,
          "vector": 0.6
        }
      },
      "input": {
        "pipelines": {
          "lexical": [
            {
              "$search": {
                "index": "song_search",
                "text": {
                  "path": {
                    "wildcard": "*"
                  },
                  "query": "rain"
                }
              }
            },
            {
              "$limit": 50
            }
          ],
          "vector": [
            {
              "$vectorSearch": {
                "index": "song_vec",
                "limit": 50,
                "numCandidates": 1000,
                "path": "embedding",
                "queryVector": [
                  0.1,
                  0.2
                ]
              }
            }
          ]
        }
      },
      "scoreDetails": false
    }
  },
  {
    "$addFields": {
      "_hybrid_score": {
        "$meta": "score"
      }
    }
  },
  {
    "$match": {
      "$or": [
        {
          "_rperm": {
            "$in": [
              "*",
              "u_alice"
            ]
          }
        },
        {
          "_rperm": {
            "$exists": false
          }
        }
      ]
    }
  },
  {
    "$sort": {
      "_hybrid_score": -1
    }
  },
  {
    "$limit": 50
  }
]
