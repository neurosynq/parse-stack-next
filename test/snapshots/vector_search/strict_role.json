[
  {
    "$vectorSearch": {
      "index": "song_vec",
      "limit": 50,
      "numCandidates": 100,
      "path": "embedding",
      "queryVector": [
        0.1,
        0.2,
        0.3
      ]
    }
  },
  {
    "$addFields": {
      "_vscore": {
        "$meta": "vectorSearchScore"
      }
    }
  },
  {
    "$match": {
      "$or": [
        {
          "_rperm": {
            "$in": [
              "role:reporting"
            ]
          }
        },
        {
          "_rperm": {
            "$exists": false
          }
        }
      ]
    }
  }
]
